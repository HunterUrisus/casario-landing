[Unit]
Description=Casario landing (Express)
After=network.target

[Service]
Type=simple
User=casario
Group=casario
WorkingDirectory=/opt/casario-landing
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node /opt/casario-landing/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
